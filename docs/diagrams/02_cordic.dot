// ===========================================================================
//  CORDIC pipeline datapath  (rtl/cordic.v)
// ===========================================================================
digraph cordic {
    rankdir=TB;
    labelloc="t";
    label=<<FONT POINT-SIZE="18"><B>CORDIC — Pipelined cos/sin Datapath</B></FONT><BR/>
           <FONT POINT-SIZE="10">circular rotation mode · 16 stages · Q4.28 internal · latency = 18 cycles</FONT><BR/> >;
    fontname="Helvetica";
    graph [fontname="Helvetica", nodesep=0.35, ranksep=0.42, bgcolor="white", splines=true];
    node  [fontname="Helvetica", fontsize=10, shape=box, style="filled,rounded", fillcolor="#eef3f8", color="#33475b", penwidth=1.3, margin="0.14,0.08"];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7, color="#33475b"];

    in    [label="angle[15:0]  (Q4.12, radians)", fillcolor="#e8eef5"];
    ext   [label="widen to Q4.28 :  ang_z = angle «16"];
    reduce[label="ARGUMENT REDUCTION  (3 conditional steps)\l  if  z > +π/2 :  z −= π ;  f ^= 1\l  if  z < −π/2 :  z += π ;  f ^= 1\l⇒ folds z into [−π/2, π/2] (CORDIC range), tracks sign-flip f\l",
           fillcolor="#fdf1e0", color="#b5762a"];
    init  [label="INIT  x₀ = 1/K = 163008219 (Q4.28) · y₀ = 0 · z₀ = reduced angle", fillcolor="#e2efe8", color="#2f7a55"];

    s0 [label="stage 0   atan(2⁰) = 0.785398   (210828714)"];
    s1 [label="stage 1   atan(2⁻¹) = 0.463648   (124459457)"];
    s2 [label="stage 2   atan(2⁻²) = 0.244979   (65760959)"];
    sd [label="…   stages 3 … 14   (pipelined registers)", fillcolor="#f4f7fa", style="filled,rounded,dashed"];
    s15[label="stage 15   atan(2⁻¹⁵) = 3.05e−5   (8192)"];

    flip [label="SIGN FLIP   if f :  x = −x ,  y = −y", fillcolor="#fdf1e0", color="#b5762a"];
    rnd  [label="ROUND + SATURATE   (x,y + 2¹³) »14  →  Q1.14, clamp [−1,1]", fillcolor="#e2efe8", color="#2f7a55"];
    out  [label="cosv[15:0] , sinv[15:0]   (Q1.14)   ·   valid", fillcolor="#e8eef5"];

    in -> ext -> reduce -> init -> s0 -> s1 -> s2 -> sd -> s15 -> flip -> rnd -> out;

    // recurrence callout
    rec [shape=note, fillcolor="#fff8e6", color="#b5762a",
         label="Per-stage recurrence (i = 0 … 15)\l──────────────────────────────\l d = (zᵢ ≥ 0) ? +1 : −1\l xᵢ₊₁ = xᵢ − d·(yᵢ » i)\l yᵢ₊₁ = yᵢ + d·(xᵢ » i)\l zᵢ₊₁ = zᵢ − d·atan(2⁻ⁱ)\l──────────────────────────────\l after 16 stages:  x → cos z₀ ,  y → sin z₀\l shift-add only — no multipliers\l"];
    rec -> s2 [style=invis];
    { rank=same; s2; rec; }

    // accuracy note
    note [shape=note, fillcolor="#eef3f8", color="#6b7c93",
          label="Verified vs numpy:\l max |cos err| = 5.4e−5\l max |sin err| = 5.7e−5\l(< 1 Q1.14 LSB)\l"];
    note -> flip [style=invis];
    { rank=same; flip; note; }
}
