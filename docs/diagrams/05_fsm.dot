// ===========================================================================
//  Control finite-state machines
// ===========================================================================
digraph fsms {
    labelloc="t";
    label=<<FONT POINT-SIZE="18"><B>Control Finite-State Machines</B></FONT><BR/>
           <FONT POINT-SIZE="10">parameter-shift controller · sequencer · gate_gen · qpu_core</FONT><BR/> >;
    fontname="Helvetica";
    graph [fontname="Helvetica", bgcolor="white", nodesep=0.35, ranksep=0.45];
    node  [fontname="Helvetica", fontsize=10, shape=ellipse, style="filled", fillcolor="#eef3f8", color="#33475b", penwidth=1.3];
    edge  [fontname="Helvetica", fontsize=8.5, arrowsize=0.7, color="#33475b"];

    // ---------------- PSR controller (pst) --------------------------------
    subgraph cluster_psr {
        label=<<B>Parameter-Shift Controller  (pst)</B>>; style="rounded,dashed"; color="#b5762a"; fontcolor="#8a5a1f";
        node [fillcolor="#fdf1e0", color="#b5762a"];
        P_IDLE; P_WAITP [label="P_WAITP\n(run +π/2)"]; P_WAITM [label="P_WAITM\n(run −π/2)"]; P_DONE;
        P_IDLE  -> P_WAITP [label="go / run_start\n(grad: ovr=+π/2)"];
        P_WAITP -> P_DONE  [label="run_done & mode0\nresult=E"];
        P_WAITP -> P_WAITM [label="run_done & mode1\nE₊=meas, ovr=−π/2"];
        P_WAITM -> P_DONE  [label="run_done\nresult=(E₊−E₋)»1"];
        P_DONE  -> P_IDLE  [label="done"];
    }

    // ---------------- Sequencer (rst_s) -----------------------------------
    subgraph cluster_seq {
        label=<<B>Sequencer / Decoder  (rst_s)</B>>; style="rounded,dashed"; color="#b5762a"; fontcolor="#8a5a1f";
        node [fillcolor="#fdf1e0", color="#b5762a"];
        R_IDLE; R_FETCH; R_DEC; R_GGEN; R_WAIT; R_NEXT; R_HALT;
        R_IDLE  -> R_FETCH [label="run_start"];
        R_FETCH -> R_DEC   [label="latch op,qA,qB,mask,pidx"];
        R_DEC   -> R_HALT  [label="op=HALT"];
        R_DEC   -> R_NEXT  [label="op=NOP"];
        R_DEC   -> R_WAIT  [label="MEAS/RESET\ncmd_start"];
        R_DEC   -> R_GGEN  [label="gate\ngg_start"];
        R_GGEN  -> R_WAIT  [label="gg_ready\ncmd_start"];
        R_WAIT  -> R_NEXT  [label="qc_done\n(capture meas)"];
        R_NEXT  -> R_FETCH [label="pc++"];
        R_HALT  -> R_IDLE  [label="run_done"];
    }

    // ---------------- gate_gen (fst) --------------------------------------
    subgraph cluster_gg {
        label=<<B>gate_gen  (fst)</B>>; style="rounded,dashed"; color="#2f7a55"; fontcolor="#256a48";
        node [fillcolor="#e2efe8", color="#2f7a55"];
        F_IDLE; F_ISSUE; F_WAIT; F_READY;
        F_IDLE  -> F_READY [label="fixed gate\n(ROM const)"];
        F_IDLE  -> F_ISSUE [label="param gate\nschedule ncalls"];
        F_ISSUE -> F_WAIT  [label="cd_start,\ncd_angle=ang[k]"];
        F_WAIT  -> F_ISSUE [label="cd_valid & k+1<ncalls\nk++"];
        F_WAIT  -> F_READY [label="cd_valid & last"];
        F_READY -> F_IDLE  [label="mready"];
    }

    // ---------------- qpu_core (st) ---------------------------------------
    subgraph cluster_core {
        label=<<B>qpu_core  (st)</B>>; style="rounded,dashed"; color="#2f7a55"; fontcolor="#256a48";
        node [fillcolor="#e2efe8", color="#2f7a55"];
        S_IDLE; S_1Q; S_2Q; S_MEAS; S_RESET; S_DONE;
        S_IDLE  -> S_1Q   [label="1Q gate"];
        S_IDLE  -> S_2Q   [label="2Q gate"];
        S_IDLE  -> S_MEAS [label="MEAS_Z"];
        S_IDLE  -> S_RESET[label="RESET"];
        S_1Q   -> S_1Q    [label="cnt++"];
        S_2Q   -> S_2Q    [label="cnt++"];
        S_MEAS -> S_MEAS  [label="cnt++"];
        S_RESET-> S_RESET [label="cnt++"];
        S_1Q   -> S_DONE  [label="cnt+1≥2ⁿ"];
        S_2Q   -> S_DONE  [label="cnt+1≥2ⁿ"];
        S_MEAS -> S_DONE  [label="last: exp_q28"];
        S_RESET-> S_DONE  [label="cnt+1≥2^N"];
        S_DONE -> S_IDLE  [label="done"];
    }
}
